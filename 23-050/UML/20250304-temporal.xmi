				<properties documentation="one-dimensional coordinate system used to record time in dateTime representation as defined in ISO 8601.&#xA;Note: A DateTimeTemporalCS shall have one axis association. It does not use axisUnitID; the temporal quantities are defined through the ISO 8601 representation." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="interface" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
