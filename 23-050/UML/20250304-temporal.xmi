<?xml  version='1.0' encoding='windows-1252' ?>
<xmi:XMI xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.omg.org/spec/UML/20161101" xmlns:umldi="http://www.omg.org/spec/UML/20161101/UMLDI" xmlns:dc="http://www.omg.org/spec/UML/20161101/UMLDC" xmlns:GML="http://www.sparxsystems.com/profiles/GML/1.0" xmlns:thecustomprofile="http://www.sparxsystems.com/profiles/thecustomprofile/1.0" xmlns:GML_Encoding="http://www.sparxsystems.com/profiles/GML_Encoding/1.0">
	<xmi:Documentation exporter="Enterprise Architect" exporterVersion="6.5" exporterID="1624"/>
	<uml:Model xmi:type="uml:Model" name="EA_Model">
		<packagedElement xmi:type="uml:Package" xmi:id="EAPK_7B64817D_A7A4_4faf_A161_FD1DC02BDAAD" name="Temporal">
			<ownedComment xmi:type="uml:Comment" xmi:id="EAID_175EDA19_2679_49b4_9CD1_2D3A164C9DDD" body="Same as Datum?&#xA;">
				<annotatedElement xmi:idref="EAPK_7B64817D_A7A4_4faf_A161_FD1DC02BDAAD"/>
			</ownedComment>
			<ownedComment xmi:type="uml:Comment" xmi:id="EAID_7CFE025D_DCDD_4e67_A324_0D850A7B3DB8" body="Note: Has at least one of: &#xA;&lt;ul&gt;&#xA;&#x9;&lt;li&gt;SpatialReferenceSystem, or&lt;/li&gt;&#xA;&#x9;&lt;li&gt;TemporalReferenceSystem&lt;/li&gt;&#xA;&lt;/ul&gt;">
				<annotatedElement xmi:idref="EAID_66AF6F39_FD9B_4460_B710_91F578B8F36A"/>
			</ownedComment>
			<ownedComment xmi:type="uml:Comment" xmi:id="EAID_E74B446F_A1C2_4b64_9FEF_463416C60B9C" body="Note: Consists of one only of:&#xA;&lt;ul&gt;&#xA;&#x9;&lt;li&gt;TemporalCoordinateReferenceSystem,&lt;/li&gt;&#xA;&#x9;&lt;li&gt;Calendar, or&lt;/li&gt;&#xA;&#x9;&lt;li&gt;OrdinalTemporalReferenceSystem&lt;/li&gt;&#xA;&lt;/ul&gt;">
				<annotatedElement xmi:idref="EAID_DCA3F5DD_F1E4_4950_8FD7_62028BE8CFE7"/>
			</ownedComment>
			<ownedComment xmi:type="uml:Comment" xmi:id="EAID_91DE8FA2_7703_4e14_AD3C_084501CEABD9" body="Is DateTime a Coordinate Reference System, a Calendar Reference System, or a combination of the two?">
				<annotatedElement xmi:idref="EAPK_7B64817D_A7A4_4faf_A161_FD1DC02BDAAD"/>
			</ownedComment>
			<ownedComment xmi:type="uml:Comment" xmi:id="EAID_40CEF85D_8189_464b_8A2F_068B781ADB01" body="Discrete&#xA;">
				<annotatedElement xmi:idref="EAPK_7B64817D_A7A4_4faf_A161_FD1DC02BDAAD"/>
			</ownedComment>
			<ownedComment xmi:type="uml:Comment" xmi:id="EAID_23304D81_E4B5_4a9f_A3DB_3DBE32028AA6" body="Continuous">
				<annotatedElement xmi:idref="EAPK_7B64817D_A7A4_4faf_A161_FD1DC02BDAAD"/>
			</ownedComment>
			<packagedElement xmi:type="uml:Package" xmi:id="EAPK_93D5073C_36B3_482d_9F88_49D78EC1AE23" name="Cache">
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_FA1F9FA2_8D93_452c_B78D_1719E971FE9C" body="Isn't TM_CoordinateSystem a TemporalMeasureCS?  It's defined as a &quot;A system for measuring time on a continuous interval scale using a single standard time interval.&quot; A TemporalMeasureCS is defined as a &quot;one-dimensional coordinate system used to record a time as a real number&quot;,&#xA;  ">
					<annotatedElement xmi:idref="EAPK_93D5073C_36B3_482d_9F88_49D78EC1AE23"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_483310CC_459C_49d2_B793_FE224267B6F1" body="If &quot;the temporal quantities are defined through the ISO 8601 representation&quot; how is this a coordinate system? &#xA;At best it's a combination of an ordinal reference system (date) and a TemporalCountCS.&#xA;&#xA;">
					<annotatedElement xmi:idref="EAPK_93D5073C_36B3_482d_9F88_49D78EC1AE23"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_69A951D4_73FA_417c_B84D_B65ED6559830" body="TM_Clock should not be limited to &quot;measuring temporal position within a day&quot;. There are many applications of a clock where the day is irrelevant. The definition should be changed to &quot;measuring temporal position within an epoch.&quot;  That epoch could be a day, or any other detectable event (mission launch, system initiation, etc.).">
					<annotatedElement xmi:idref="EAPK_93D5073C_36B3_482d_9F88_49D78EC1AE23"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_3CF17CF1_E62B_4749_9000_0C933A3C78B9" body="Under Minkowski Spacetime, space and time recede into the background.  What we are left with is a 4D coordinate reference system. &quot;With appropriate setting of space and time the substance existing at any worldpoint can always be regarded as being at rest&quot;. Therefore, the &quot;proper&quot; location and time for a moving object can always be determined through a transformation of the 4D coordinate reference system.  ">
					<annotatedElement xmi:idref="EAPK_93D5073C_36B3_482d_9F88_49D78EC1AE23"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_9FC9AB95_2358_4a8d_A1B6_40D8F6672D40" body="DateTime is arguably an Ordinal Reference System, not a Coordinate Reference System,">
					<annotatedElement xmi:idref="EAPK_93D5073C_36B3_482d_9F88_49D78EC1AE23"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_7A735DCB_2A47_47f2_802B_D2117E7695C5" body="TM_CoordinateSystem is either a continuous (TemporalMeasureCS) or discrete (TemporalCountCS) Coordinate Reference System. ">
					<annotatedElement xmi:idref="EAPK_93D5073C_36B3_482d_9F88_49D78EC1AE23"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_739E826A_B241_4625_BE57_26FB5E4B8028" body="A calendar is a type of TM_OrdinalReferenceSystem.">
					<annotatedElement xmi:idref="EAPK_93D5073C_36B3_482d_9F88_49D78EC1AE23"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_D3F83FE7_524A_443b_A052_44011FA4ADE7" body="Is a TM_Clock a Reference System or is it a Feature that observes a TM_CoordinateSystem?">
					<annotatedElement xmi:idref="EAPK_93D5073C_36B3_482d_9F88_49D78EC1AE23"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_803D868B_3380_4770_89BF_CE3A179F0E19" body="Is a coordinate system a reference system?">
					<annotatedElement xmi:idref="EAPK_93D5073C_36B3_482d_9F88_49D78EC1AE23"/>
				</ownedComment>
			</packagedElement>
