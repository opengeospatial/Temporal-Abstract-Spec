			<element xmi:idref="EAID_3CF17CF1_E62B_4749_9000_0C933A3C78B9" xmi:type="uml:Note" scope="public">
				<model package="EAPK_93D5073C_36B3_482d_9F88_49D78EC1AE23" tpos="0" ea_localid="236" ea_eleType="element"/>
				<properties documentation="Under Minkowski Spacetime, space and time recede into the background.  What we are left with is a 4D coordinate reference system. &quot;With appropriate setting of space and time the substance existing at any worldpoint can always be regarded as being at rest&quot;. Therefore, the &quot;proper&quot; location and time for a moving object can always be determined through a transformation of the 4D coordinate reference system.  " isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="cheaz" version="1.0" phase="1.0" created="2023-05-09 11:18:05" modified="2023-05-09 11:22:55" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="Cache"/>
			</element>
			<element xmi:idref="EAID_69A951D4_73FA_417c_B84D_B65ED6559830" xmi:type="uml:Note" scope="public">
				<model package="EAPK_93D5073C_36B3_482d_9F88_49D78EC1AE23" tpos="0" ea_localid="234" ea_eleType="element"/>
				<properties documentation="TM_Clock should not be limited to &quot;measuring temporal position within a day&quot;. There are many applications of a clock where the day is irrelevant. The definition should be changed to &quot;measuring temporal position within an epoch.&quot;  That epoch could be a day, or any other detectable event (mission launch, system initiation, etc.)." isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="cheaz" version="1.0" phase="1.0" created="2023-05-08 19:19:24" modified="2023-05-08 19:24:10" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="Cache"/>
			</element>
			<element xmi:idref="EAID_483310CC_459C_49d2_B793_FE224267B6F1" xmi:type="uml:Note" scope="public">
				<model package="EAPK_93D5073C_36B3_482d_9F88_49D78EC1AE23" tpos="0" ea_localid="233" ea_eleType="element"/>
				<properties documentation="If &quot;the temporal quantities are defined through the ISO 8601 representation&quot; how is this a coordinate system? &#xA;At best it's a combination of an ordinal reference system (date) and a TemporalCountCS.&#xA;&#xA;" isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="cheaz" version="1.0" phase="1.0" created="2023-05-08 19:09:31" modified="2023-05-08 19:12:21" complexity="1" status="Proposed"/>
