					<attribute xmi:idref="EAID_7404E856_530F_4abf_B061_31DE445E021C" name="conventionalRS" scope="Public">
						<initial/>
						<documentation value="name, identifier, alias and remarks for the terrestrial reference system or vertical reference system realized by this reference frame&#xA;Examples: &quot;ITRS&quot; for ITRF88 through ITRF2008 and ITRF2014, or &quot;EVRS&quot; for EVRF2000 and EVRF2007."/>
						<model ea_localid="16312" ea_guid="{7404E856-530F-4abf-B061-31DE445E021C}"/>
